// Empty overlay that removes the heavy GMS apps from the image (the device has 4 GB of RAM).
// Everything listed here can be installed afterwards as a normal APK.
runtime_resource_overlay {
    name: "GmsHeavyTrim",
    overrides: [
        "WellbeingPrebuilt",
        "TurboPrebuilt",
        "GeminiShell_227",
        "PulsePrebuilt",
        "SafetyHubPrebuilt",
        "FamilySpacePrebuilt-v2026",
        "RelationshipsPrebuilt-301",
        "AdaptiveVPNPrebuilt-111042",
        "CarrierMetrics",
        "CbrsNetworkMonitor",
        "DeviceConnectivityServicePrebuilt_26.01.00",
        "CrossDeviceAccessServicePrimary",
        "Flipendo",
        "GoogleFeedback",
        "KidsSupervisionStub",
        "AiIconsPrebuilt_20260121",
        "WallpaperAIPrebuilt_10000372",
        "MagicPortraitWallpapers",
        "YourWidgetsStub",
        "AndroidGlassesCoreStub",
        "DevicePolicyPrebuilt-v10572820",
        "WeatherPixelPrebuilt_10008663",
        "DeviceIntelligenceNetworkPrebuiltAstrea",
        "DevicePersonalizationAiAiPrebuiltPixel2026",
        "Velvet",
        "NgaResources",
        "GoogleTTS",
    ],
    product_specific: true,
    sdk_version: "current",
}
