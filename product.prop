# IMS
ro.telephony.block_binder_thread_on_incoming_calls=false

# LMKD
# PSI-based kill strategy (the kernel has PSI triggers). The legacy minfree mode never killed
# anything on this 4 GB device, so cached apps piled up in zram and everything thrashed.
ro.lmk.kill_heaviest_task=true
ro.lmk.kill_timeout_ms=100
ro.lmk.use_minfree_levels=false
ro.lmk.swap_free_low_percentage=20
